# ========================================================
# Operating Mode: YES (Production - real Kea daemons) | NO (Mockup data simulation)
# Default: YES
# ========================================================
PRODUCTION=YES

# ========================================================
# Kea DHCP Web UI Server Configuration
# ========================================================
PORT=3000
NODE_ENV=production
JWT_SECRET=your_jwt_secret_key_here

# Kea Control Agent & Service Configuration
KEA_CTRL_AGENT_URL=http://[IP_ADDRESS]/keactrl
KEA_CONF_PATH=/etc/kea/kea-dhcp4.conf
KEA_CTRL_AGENT_CONF_PATH=/etc/kea/kea-ctrl-agent.conf
KEA_BACKUP_DIR=/etc/kea/backups

# Optional: Initial admin password for first launch
ADMIN_PASSWORD=admin
