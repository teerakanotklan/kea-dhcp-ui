# ========================================================
# Remote Deployment Configuration (scripts/deploy.py)
# ========================================================
REMOTE_HOST=your_remote_ip_here
REMOTE_PORT=22
REMOTE_USER=your_username
REMOTE_PASS=your_remote_password_here
REMOTE_DIR=/opt/kea-dhcp-ui

# ========================================================
# Backend Server Configuration (server/)
# ========================================================
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here

# Optional: Initial admin password for first launch
ADMIN_PASSWORD=admin123
