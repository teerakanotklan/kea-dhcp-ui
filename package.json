{
  "name": "isc-dhcp-ui",
  "version": "1.0.0",
  "description": "Modern Web UI for ISC DHCP Server Management",
  "private": true,
  "scripts": {
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm --prefix client run build",
    "verify": "node server/scripts/test-verify.js",
    "deploy:remote": "python scripts/deploy.py",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
